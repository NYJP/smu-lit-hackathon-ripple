OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1     # override for a local/proxy endpoint
RIPPLE_EMBEDDING_MODEL=text-embedding-3-small # 1536 dims
# gpt-5 rejects temperature != 1 and requires max_completion_tokens rather
# than max_tokens. See PRD section 11 before changing these.
RIPPLE_REASONING_MODEL=gpt-5                  # extraction, impact, recommendations
RIPPLE_BULK_MODEL=gpt-5                       # dependency adjudication (high volume)
RIPPLE_DATA_DIR=./data
RIPPLE_MAX_CONCURRENT_LLM_CALLS=5

# Section 9 preamble: the web app (:3000) and the API (:8000) are different
# origins, same site. CORS must name the web origin exactly — never "*",
# which browsers reject alongside credentialed requests anyway.
RIPPLE_WEB_ORIGIN=http://localhost:3000

# Uncomment and change if 8000 is already in use on your machine. `run.py
# dev` reads this, starts uvicorn on it, and writes it into web/.env.local
# so the web app's API base URL always matches the port actually in use.
# RIPPLE_API_PORT=8000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
